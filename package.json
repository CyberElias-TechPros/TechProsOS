{
  "name": "techpros-one",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TechPros One \u2014 the unified IT operations & business technology platform",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:integration": "vitest run tests/server-integration.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm audit --audit-level=moderate && node scripts/check-bundle-budget.mjs",
    "audit:release": "npm audit --omit=dev --audit-level=high",
    "dev:api": "tsx watch server/dev.ts",
    "dev:live": "APP_MODE=live tsx watch server/dev.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "framer-motion": "^11.11.17",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "ogl": "^1.0.11",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.13.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@fontsource-variable/inter": "^5.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^25.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
