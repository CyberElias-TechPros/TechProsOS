# TechPros One — server configuration. Copy to .env.local for local development.
# NEVER commit real values. In GitHub/Vercel, add these as encrypted environment variables.

# live = server-authoritative PostgreSQL mode (default). demo = explicitly fictional browser demo API.
APP_MODE=live

# Canonical public origin. Must match the browser origin exactly (scheme + host + port).
# Local Vite: http://localhost:5173. Vercel production: https://your-domain.example
APP_URL=http://localhost:5173

# PostgreSQL connection string. Use sslmode=require or verify-full for managed Postgres.
DATABASE_URL=postgresql://user:password@host:5432/techpros?sslmode=require

# 32 random bytes, base64-encoded. Generate: openssl rand -base64 32
# Used for AES-256-GCM encryption of authenticator secrets. Rotating requires re-enrollment.
DATA_ENCRYPTION_KEY=

# At least 32 random characters. Protects /api/cron/run. Generate: openssl rand -hex 32
CRON_SECRET=

# Transactional email (Resend). Required for live registration, invitations and resets.
RESEND_API_KEY=
EMAIL_FROM=TechPros One <no-reply@your-domain.example>

# Paystack secret key. Required for verified subscription and invoice checkout.
PAYSTACK_SECRET_KEY=

# Local API dev server port (Vite proxies /api here).
API_PORT=8787
